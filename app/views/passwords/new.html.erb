<% content_for :title, "Reset your password" %>
<% content_for :page, "forgot" %>
<div class="auth-page"><div class="card auth-card">
  <%= link_to new_session_path, class: "back-link" do %><%= icon(:arrow_left) %>Back to sign in<% end %>
  <div><h1 class="auth-title">Reset your password</h1><p class="auth-lead">Enter the email you signed up with and we’ll send you a reset link.</p></div>
  <%= form_with url: passwords_path, class: "auth-form", id: "forgot-form", html: { novalidate: true },
        data: { controller: "validation", action: "submit->validation#submit" } do %>
    <%= error_summary(@error ? [ [ "email", @error ] ] : []) %>
    <%= form_field id: "email", name: "email_address", label: "Email", type: :email, autocomplete: "email", value: @email, error: @error,
          rules: { required: "Enter your email address.", email: "Enter an email address like name@example.com." } %>
    <button class="btn btn-primary btn-lg btn-block" type="submit">Send reset link</button>
  <% end %>
</div></div>
