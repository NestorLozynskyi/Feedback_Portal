<% content_for :title, "Choose a new password" %>
<% content_for :page, "reset" %>
<% errs = (@errors || []).to_h %>
<div class="auth-page"><div class="card auth-card">
  <div><h1 class="auth-title">Choose a new password</h1><p class="auth-lead">For <%= @user.email_address %></p></div>
  <%= form_with url: password_path(params[:token]), method: :put, class: "auth-form", id: "reset-form", html: { novalidate: true },
        data: { controller: "validation", action: "submit->validation#submit" } do %>
    <%= error_summary(@errors || []) %>
    <%= form_field id: "password", name: "password", label: "New password", type: :password, autocomplete: "new-password",
          hint: "At least 8 characters.", error: errs["password"],
          rules: { required: "Enter a new password.", minlength: [ 8, "Use at least 8 characters for your password." ] } %>
    <%= form_field id: "password_confirmation", name: "password_confirmation", label: "Confirm new password", type: :password, autocomplete: "new-password",
          error: errs["password_confirmation"],
          rules: { required: "Enter your new password again.", match: [ "password", "Passwords don’t match. Enter the same password twice." ] } %>
    <button class="btn btn-primary btn-lg btn-block" type="submit">Update password</button>
  <% end %>
</div></div>
