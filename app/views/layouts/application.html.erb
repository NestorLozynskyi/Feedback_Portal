<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= page_title(content_for(:title).presence) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= product_name %>">
    <script>try{var t=localStorage.getItem('fp-theme');if(!t)t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.theme=t}catch(e){document.documentElement.dataset.theme='light'}</script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-page="<%= content_for(:page) %>">
    <a class="skip-link" href="#main">Skip to content</a>
    <%= render "shared/header" %>
    <div id="app-banner"><%= render "shared/restricted_banner" if restricted? %></div>
    <main id="main" tabindex="-1">
      <%= yield %>
    </main>
    <div class="toast-region" id="toasts" role="status" aria-live="polite">
      <% flash.each do |type, message| %>
        <%= render "shared/toast", message: message, kind: type %>
      <% end %>
    </div>
    <%= render "shared/confirm_dialog" %>
  </body>
</html>
