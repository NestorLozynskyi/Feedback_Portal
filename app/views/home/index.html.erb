<% content_for :title, "Feedback Portal" %>

<section class="w-full max-w-2xl mx-auto">
  <h1 class="text-4xl font-bold tracking-tight text-gray-900">Feedback Portal</h1>
  <p class="mt-3 text-lg text-gray-600">Placeholder home page. Product features will be added in later tasks.</p>

  <div id="auth-status" class="mt-8 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <% if authenticated? %>
      <p class="text-gray-800" data-testid="auth-status">
        Signed in as <strong><%= Current.user.email_address %></strong>
      </p>
    <% else %>
      <p class="text-gray-800" data-testid="auth-status">You are browsing as a guest.</p>
      <%= link_to "Sign in", new_session_path, class: "mt-4 inline-block rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
    <% end %>
  </div>
</section>
