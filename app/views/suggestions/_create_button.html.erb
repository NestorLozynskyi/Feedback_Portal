<% if !current_user %>
  <%= link_to signin_path_for("create", return_to: new_suggestion_path), class: "btn btn-primary" do %><%= icon(:plus) %>New suggestion<% end %>
<% elsif current_user.blocked? %>
  <button class="btn btn-primary" type="button" disabled aria-describedby="restricted-text"><%= icon(:plus) %>New suggestion</button>
<% else %>
  <%= link_to new_suggestion_path, class: "btn btn-primary" do %><%= icon(:plus) %>New suggestion<% end %>
<% end %>
