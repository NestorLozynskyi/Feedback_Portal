<% content_for :title, "Sign in" %>
<% content_for :page, "signin" %>
<div class="auth-page"><div class="card auth-card">
  <div><h1 class="auth-title">Sign in</h1><p class="auth-lead">Welcome back to <%= product_name %>.</p></div>
  <% if @reason %>
    <div class="notice notice-info"><%= icon(:lock) %><p class="notice-text"><%= @reason %></p></div>
  <% end %>
  <% if @invalid %>
    <div class="notice notice-danger" role="alert"><%= icon(:alert) %><p class="notice-text">Incorrect email or password. Check your details and try again.</p></div>
  <% end %>
  <%= form_with url: session_path, class: "auth-form", id: "signin-form", html: { novalidate: true },
        data: { controller: "validation", action: "submit->validation#submit" } do %>
    <%= error_summary([]) %>
    <%= form_field id: "email", name: "email_address", label: "Email", type: :email, autocomplete: "email", value: @email,
          rules: { required: "Enter your email address.", email: "Enter an email address like name@example.com." } %>
    <%= form_field id: "password", name: "password", label: "Password", type: :password, autocomplete: "current-password",
          aside: link_to("Forgot password?", new_password_path, class: "link-sm"), rules: { required: "Enter your password." } %>
    <button class="btn btn-primary btn-lg btn-block" type="submit">Sign in</button>
  <% end %>
  <p class="auth-switch">New to <%= product_name %>? <%= link_to "Create an account", new_registration_path %></p>
</div></div>
